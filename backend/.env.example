# Local development only. `make up` copies this to backend/.env.dev (git-ignored)
# and fills the three secrets with random values. Never use these outside your machine.
APP_ENV=dev
DATABASE_URL=postgresql://coins:coins@db:5432/coins
TEST_DATABASE_URL=postgresql://coins:coins@db:5432/coins_test
DEV_OTP=123456
SURPRISE_SECRET=change-me
INVITE_SECRET=change-me
VOUCHER_KEY=change-me
VENDOR_URL=http://vendor:8090
VENDOR_TIMEOUT_SECONDS=3
SMTP_HOST=mail
SMTP_PORT=1025
PUBLIC_BASE_URL=http://localhost:8080
WORKER_POLL_SECONDS=0.5
