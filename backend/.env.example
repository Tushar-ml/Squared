# Local development only. `make up` copies this to backend/.env.dev (git-ignored)
# and fills the secrets with random values. Never use these outside your machine.
APP_ENV=dev
DATABASE_URL=postgresql://coins:coins@db:5432/coins
TEST_DATABASE_URL=postgresql://coins:coins@db:5432/coins_test
SURPRISE_SECRET=change-me
INVITE_SECRET=change-me
VOUCHER_KEY=change-me
# Behind a load balancer, set TRUST_PROXY=1 so the API sees the real client IP
TRUST_PROXY=0
VENDOR_URL=http://vendor:8090
VENDOR_TIMEOUT_SECONDS=3
SMTP_HOST=mail
SMTP_PORT=1025
PUBLIC_BASE_URL=http://localhost:8080
WORKER_POLL_SECONDS=0.5
# Bill photos: local disk in dev. Production needs S3-compatible storage (AWS S3, Cloudflare R2):
# STORAGE_BACKEND=s3, S3_BUCKET, S3_ENDPOINT_URL (R2 only), S3_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
STORAGE_BACKEND=local
# Public pages and Universal Links (all required in production)
SUPPORT_EMAIL=
OPERATOR_NAME=Squared
APPLE_TEAM_ID=
IOS_BUNDLE_ID=app.squared.ios
# Sign in with Google / Apple (production). Locally, sign in with the dev-only /auth/dev endpoint.
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
OPS_EMAILS=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
