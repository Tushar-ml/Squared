<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Squared</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>hi</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.squared.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>squared</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>upi</string>
		<string>whatsapp</string>
		<string>phonepe</string>
		<string>gpay</string>
		<string>paytmmp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Squared uses Bluetooth to sync shared groups with friends' phones nearby.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_sqd-sync._tcp</string>
		<string>_sqd-sync._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo of a bill to attach it and read the total.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock Squared with Face ID.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Squared finds friends' phones nearby to sync shared groups directly, without the internet.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach a photo of a bill to an expense.</string>
	<key>RCAPIBaseURL</key>
	<string>$(SQUARED_API_BASE_URL)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
